{
  "schema_version": 1,
  "provider": "google",
  "client_type": "desktop",
  "authorization_flow": "authorization_code_pkce",
  "pkce_method": "S256",
  "redirect": "http://127.0.0.1:{ephemeral-port}/oauth/callback",
  "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
  "token_endpoint": "https://oauth2.googleapis.com/token",
  "revocation_endpoint": "https://oauth2.googleapis.com/revoke",
  "audience": "user_selected_google_account",
  "scope_sets": {
    "identity": [
      "openid",
      "https://www.googleapis.com/auth/userinfo.email"
    ],
    "apps_script_read": [
      "https://www.googleapis.com/auth/script.projects.readonly",
      "https://www.googleapis.com/auth/script.deployments.readonly"
    ],
    "apps_script_edit": [
      "https://www.googleapis.com/auth/script.projects"
    ],
    "apps_script_deploy": [
      "https://www.googleapis.com/auth/script.deployments"
    ]
  },
  "consent": "explicit_scope_mode_reconsent_for_desktop",
  "credential_storage": "os_encrypted_secure_store_per_account_and_installation",
  "app_script_api": "google_oauth_access_token_only_with_explicit_script_id",
  "clasp_mcp_auth": "separate_isolated_credential_bootstrap_required",
  "appsheet": {
    "editor": "interactive_google_sign_in_in_browser",
    "data_api": "per_app_application_access_key_enterprise_only",
    "team_admin_api": "separate_team_key_and_admin_permissions"
  }
}
